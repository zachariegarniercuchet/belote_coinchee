#!/bin/sh
# Local publication gate. No cached approval, environment override or auto-yes.
set -eu

remote_name=${1:-unknown}
remote_url=${2:-unknown}
first_oid=

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ -z "$first_oid" ]; then
        first_oid=$local_oid
        printf '\nPUSH EN ATTENTE — %s (%s)\n' "$remote_name" "$remote_url" >&2
        printf 'Un deploiement automatique peut redemarrer le serveur et perdre les parties en cours.\n' >&2
    fi
    printf '  %s -> %s : %s\n' "$local_ref" "$remote_ref" "$local_oid" >&2
done

# No ref update means nothing can be published or deployed.
[ -n "$first_oid" ] || exit 0

if [ ! -t 2 ]; then
    printf 'PUSH BLOQUE : confirmation explicite requise dans un terminal interactif.\n' >&2
    exit 1
fi

short_oid=$(printf '%.12s' "$first_oid")
expected="PUSH $short_oid"
printf 'Pour autoriser CETTE publication maintenant, saisir exactement "%s" : ' "$expected" >&2
reply=
if ! IFS= read -r reply </dev/tty; then
    printf '\nPUSH BLOQUE : aucune confirmation recue.\n' >&2
    exit 1
fi
if [ "$reply" != "$expected" ]; then
    printf 'PUSH ANNULE : confirmation absente ou incorrecte.\n' >&2
    exit 1
fi

printf 'Confirmation recue pour %s.\n' "$short_oid" >&2
